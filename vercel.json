{
  "version": 2,
  "buildCommand": null,
  "framework": null,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "STEAM_API_KEY": "@steam-api-key",
    "RETURN_URL": "https://votre-site.vercel.app/api/auth/steam/return",
    "REALM": "https://votre-site.vercel.app/"
  }
}
